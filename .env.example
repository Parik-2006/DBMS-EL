# MaliciousBot environment template. Copy to .env (git-ignored) and fill in.
# NEVER commit real values. Every value below is a non-secret placeholder.

# --- Django ---
SECRET_KEY=replace-with-a-random-string-of-at-least-32-characters
DEBUG=True
ALLOWED_HOSTS=127.0.0.1,localhost
CSRF_TRUSTED_ORIGINS=
# Production-only overrides (defaults are derived from RENDER/PRODUCTION):
# SECURE_SSL_REDIRECT=True
# SECURE_HSTS_SECONDS=86400
# SESSION_COOKIE_SECURE=True
# CSRF_COOKIE_SECURE=True

# --- MySQL (runtime application user) ---
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=maliciousbot_app
MYSQL_PASSWORD=
MYSQL_CORE_DATABASE=maliciousbot_core
MYSQL_GUEST_DATABASE=maliciousbot_guest
# Provisioning account (CREATE DATABASE + GRANT); falls back to MYSQL_USER.
MYSQL_ADMIN_USER=
MYSQL_ADMIN_PASSWORD=
MYSQL_APP_USER_HOSTS=localhost,127.0.0.1
# TLS: DISABLED | REQUIRED | VERIFY_CA | VERIFY_IDENTITY ; CA = path or inline PEM
MYSQL_SSL_MODE=
MYSQL_SSL_CA=

# --- MongoDB (forensic evidence) ---
MONGODB_URI=
MONGODB_DATABASE=nikhil_db
MONGODB_COLLECTION=deep_analysis_cases
MONGO_FALLBACK_CACHE_SIZE=256

# --- PARI / Nikhil ---
PARI_CONFIDENCE_THRESHOLD=0.75
NIKHIL_MAX_SECONDS=45
STALE_SCAN_MINUTES=15
VISUAL_ANALYSIS_ENABLED=true
SCREENSHOT_MAX_BYTES=5242880
OUTBOUND_ALLOWED_PORTS=80,443,8080,8443

# --- AI (free-only) ---
AI_ENABLED=true
FREE_ONLY=true
ALLOW_PAID_PROVIDERS=false
GEMINI_ENABLED=true
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
OPENROUTER_ENABLED=false
OPENROUTER_API_KEY=
OPENROUTER_MODEL=liquid/lfm-2.5-2.6b:free

# --- Threat intelligence ---
THREATFOX_API_KEY=
URLHAUS_API_KEY=
ABUSEIPDB_API_KEY=

# --- API security / rate limiting ---
# Required only for the external worker endpoint POST /api/fallback/result/ (>= 32 chars).
FALLBACK_SERVICE_TOKEN=
RATE_LIMIT_ENABLED=true
# CACHE_BACKEND=database shares rate-limit state across workers (run createcachetable).
CACHE_BACKEND=
TRUSTED_PROXY_COUNT=0
# Format: <count>/<seconds>
RATE_LIMIT_LOGIN_IP=20/300
RATE_LIMIT_LOGIN_USER=5/300
RATE_LIMIT_REGISTER=10/3600
RATE_LIMIT_SCAN=20/600
RATE_LIMIT_API=120/60
RATE_LIMIT_REVIEW=60/600
